# Managed by Ansible — do not edit manually
network:
  version: 2
  renderer: networkd
  ethernets:
    {{ eth_interface }}:
      dhcp4: false
      addresses:
        - {{ static_ip }}/24
{% if legacy_ip is defined %}
        - {{ legacy_ip }}/24  # pre-renumbering address; Swarm's raft state still advertises the manager on this subnet
{% endif %}
      routes:
        - to: default
          via: {{ network_gateway }}
      nameservers:
        addresses: {{ dns_servers | to_json }}
        search:
          - {{ search_domain }}
