        "query": "All : .*,airflow-scheduler : airflow-scheduler,airflow-dag-processor : airflow-dag-processor,airflow-triggerer : airflow-triggerer,airflow-apiserver : airflow-apiserver,airflow-worker : airflow-worker,airflow-worker-claude : airflow-worker-claude,tradingo-worker : tradingo-worker,tradingo-mcp : tradingo-mcp",
