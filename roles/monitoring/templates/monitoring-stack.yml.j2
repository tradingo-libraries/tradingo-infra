# {{ ansible_managed }}
version: "3.8"

services:
  node-exporter:
    image: prom/node-exporter:latest
    networks:
      - monitoring
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro
      - /var/lib/node_exporter/textfile_collector:/var/lib/node_exporter/textfile_collector:ro
    command:
      - "--path.procfs=/host/proc"
      - "--path.sysfs=/host/sys"
      - "--path.rootfs=/rootfs"
      - "--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)"
      - "--collector.textfile.directory=/var/lib/node_exporter/textfile_collector"
    deploy:
      mode: global
      resources:
        limits:
          memory: 128M

  cadvisor:
    image: gcr.io/cadvisor/cadvisor:latest
    networks:
      - monitoring
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    deploy:
      mode: global
      resources:
        limits:
          memory: 256M

  prometheus:
    image: prom/prometheus:latest
    user: root
    networks:
      - monitoring
    ports:
      - "9090:9090"
    volumes:
      - prometheus-data:/prometheus
      - {{ monitoring_config_dir }}/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--storage.tsdb.retention.time={{ prometheus_retention }}"
      - "--storage.tsdb.retention.size={{ prometheus_retention_size }}"
      - "--web.console.libraries=/etc/prometheus/console_libraries"
      - "--web.console.templates=/etc/prometheus/consoles"
      - "--web.enable-remote-write-receiver"
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.labels.workload == platform
      resources:
        limits:
          memory: 1G

  grafana:
    image: grafana/grafana:latest
    networks:
      - monitoring
      - tradingo_tradingo-backend
    ports:
      - "3000:3000"
    volumes:
      - grafana-data:/var/lib/grafana
      - {{ monitoring_config_dir }}/grafana/datasources:/etc/grafana/provisioning/datasources:ro
      - {{ monitoring_config_dir }}/grafana/dashboards:/etc/grafana/provisioning/dashboards:ro
      - {{ monitoring_config_dir }}/grafana/dashboard-json:/etc/grafana/dashboards:ro
      - {{ monitoring_config_dir }}/grafana/dashboard-json/polymarket:/etc/grafana/dashboards/polymarket:ro
    environment:
      GF_SECURITY_ADMIN_PASSWORD: "{{ grafana_admin_password }}"
      GF_INSTALL_PLUGINS: grafana-clickhouse-datasource
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.labels.node == nuc-02
      resources:
        limits:
          memory: 512M

  loki:
    image: grafana/loki:latest
    networks:
      - monitoring
    ports:
      - "3100:3100"
    volumes:
      - loki-data:/loki
      - {{ monitoring_config_dir }}/loki.yml:/etc/loki/loki.yml:ro
    command: -config.file=/etc/loki/loki.yml
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.labels.node == nuc-02
      resources:
        limits:
          memory: 1G

  promtail:
    image: grafana/promtail:latest
    networks:
      - monitoring
    volumes:
      - /var/lib/docker/containers:/var/lib/docker/containers:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - {{ monitoring_config_dir }}/promtail.yml:/etc/promtail/promtail.yml:ro
    command: -config.file=/etc/promtail/promtail.yml
    deploy:
      mode: global
      resources:
        limits:
          memory: 128M

  postgres-exporter:
    image: prometheuscommunity/postgres-exporter:latest
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        export DATA_SOURCE_NAME="postgresql://service:$$(cat /run/secrets/postgres_password | tr -d '\n')@postgres/postgres?sslmode=disable"
        exec /bin/postgres_exporter
    secrets:
      - postgres_password
    networks:
      - monitoring
      - tradingo_tradingo-backend
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.role == manager
      resources:
        limits:
          memory: 64M
      restart_policy:
        condition: on-failure
        delay: 10s

  alloy:
    image: grafana/alloy:latest
    networks:
      - monitoring
      - tradingo_tradingo-backend
    volumes:
      - {{ monitoring_config_dir }}/alloy.river:/etc/alloy/config.alloy:ro
    command:
      - "run"
      - "--server.http.listen-addr=0.0.0.0:12345"
      - "/etc/alloy/config.alloy"
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.labels.node == nuc-02
      resources:
        limits:
          memory: 256M

  tempo:
    image: grafana/tempo:latest
    command: ["-config.file=/etc/tempo/tempo.yml"]
    networks:
      - monitoring
      - tradingo_tradingo-backend
    ports:
      - "3200:3200"
      - "4317:4317"
      - "4318:4318"
    volumes:
      - tempo-data:/var/tempo
      - {{ monitoring_config_dir }}/tempo.yml:/etc/tempo/tempo.yml:ro
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.labels.node == nuc-02
      resources:
        limits:
          memory: 1G

  grafana-mcp:
    image: grafana/mcp-grafana:latest
    networks:
      - monitoring
    ports:
      - "8766:8000"
    environment:
      GRAFANA_URL: "{{ grafana_url }}"
      GRAFANA_API_KEY: "{{ grafana_api_key | default('') }}"
    stop_grace_period: 30s
    entrypoint:
      - "/app/mcp-grafana"
      - "--transport"
      - "streamable-http"
      - "--address"
      - "0.0.0.0:8000"
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.labels.node == nuc-02
      resources:
        limits:
          memory: 128M

networks:
  monitoring:
    external: true
  tradingo_tradingo-backend:
    external: true

secrets:
  postgres_password:
    external: true

volumes:
  prometheus-data:
  grafana-data:
  loki-data:
  tempo-data:
