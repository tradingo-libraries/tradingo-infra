# {{ ansible_managed }}
apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: http://prometheus:9090
    isDefault: true
    editable: false

  - name: Loki
    type: loki
    access: proxy
    url: http://loki:3100
    editable: false

  - name: ClickHouse
    type: grafana-clickhouse-datasource
    uid: clickhouse-polymarket
    jsonData:
      server: clickhouse
      port: 8123
      username: default
      defaultDatabase: polymarket
      protocol: http
    secureJsonData:
      password: "{{ clickhouse_password }}"

  - name: Tempo
    type: tempo
    access: proxy
    url: http://tempo:3200
    editable: false
    jsonData:
      tracesToLogsV2:
        datasourceUid: P8E80F9AEF21F6940
        filterByTraceID: true
        filterBySpanID: false
        customQuery: true
        # $$ escapes Grafana's provisioning env-var expansion, which would otherwise blank
        # ${__span...} and leave the query as {service_name=""} |= ""
        query: '{service_name="$${__span.tags["service.name"]}"} |= "$${__span.traceId}"'
      tracesToMetrics:
        datasourceUid: PBFA97CFB590B2093
        spanStartTimeShift: "-1m"
        spanEndTimeShift: "1m"
        tags:
          - key: service.name
            value: service
        queries:
          - name: Request rate
            query: rate(traces_spanmetrics_calls_total{$$__tags}[5m])
      serviceMap:
        datasourceUid: PBFA97CFB590B2093
      nodeGraph:
        enabled: true
      # Traces Drilldown streams search and TraceQL-metrics results
      streamingEnabled:
        search: true
        metrics: true
      lokiSearch:
        datasourceUid: P8E80F9AEF21F6940
